# Phase 6 full-stack config (db/auth/rest/realtime/kong/edge-runtime/
# meilisearch/webauthn/supavisor/backup). Copy to .env and fill in real
# secrets — never commit a real .env.
#
#   openssl rand -base64 48   # for POSTGRES_PASSWORD, JWT_SECRET, SECRET_KEY_BASE
#   openssl rand -hex 16      # for VAULT_ENC_KEY (must be exactly 32 hex chars)

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-chars

# Generated from JWT_SECRET above via ../scripts/generate-supabase-keys.mjs
# (run that script after setting JWT_SECRET, then paste its output here).
ANON_KEY=
SERVICE_ROLE_KEY=

# Public URL of this stack once deployed behind Kong (matches the plan's
# eventual reverse-proxy setup, same shape as frontend/'s VITE_API_URL today).
SUPABASE_PUBLIC_URL=http://localhost:8000

# Frontend origin, for GoTrue's SITE_URL / redirect allow-list.
SITE_URL=http://localhost:5173
URI_ALLOW_LIST=http://localhost:5173

# SMTP for GoTrue's own emails (password recovery). Optional at this phase —
# admin-created accounts are pre-confirmed via the admin API, not email
# confirmation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# SMTP for the notify-document-status / notify-hearing-scheduled Edge
# Functions (separate from GoTrue's SMTP_* above — same underlying mail
# provider is fine, GoTrue and the functions just read different var names).
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=CLUSTR

WEBAUTHN_RP_NAME=CLUSTR Barangay OS
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8080

# Meilisearch — full-text search proxy (search-index/search-query Edge
# Functions). No-op / falls back to the per-table query path until set.
MEILI_MASTER_KEY=
MEILI_ENV=development

# Realtime service. DB_ENC_KEY has no real secret-strength requirement (it
# encrypts Realtime's own internal tenant config at rest, not user data) —
# the image's documented default is fine to keep unless you have a reason
# to change it. SECRET_KEY_BASE is shared with Supavisor below (both are
# Elixir/Phoenix services that use it the same way — signing internal
# tokens/cookies, never sent to a client).
REALTIME_DB_ENC_KEY=supabaserealtime
SECRET_KEY_BASE=change-me-64-plus-chars

# Supavisor connection pooler. VAULT_ENC_KEY must be exactly 32 hex
# characters. POOLER_TENANT_ID is an arbitrary label for this single
# deployment (there is one Postgres database here, not a fleet) — pick
# anything unique if running more than one Supavisor-fronted stack.
VAULT_ENC_KEY=change-me-32-hex-chars-exactly12
POOLER_TENANT_ID=barangay
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=200

# Continuous Postgres backup (pgBackRest, replaces backend/litestream.yml).
# No-op / fails stanza-create until BACKUP_S3_BUCKET and BACKUP_S3_ENDPOINT
# are set — same deferred-until-configured pattern litestream.yml used.
PGBACKREST_STANZA=barangay
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

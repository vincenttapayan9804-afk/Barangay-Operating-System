# Edge Function secrets for this directory's functions (notify-*, search-*).
# Local dev: `supabase functions serve --env-file functions/.env`
# Real deploy: `supabase secrets set --env-file functions/.env`
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the platform into every function — do not set them here.

# notify-document-status / notify-hearing-scheduled (see ../functions/_shared/mailer.ts).
# A real, documented behavior change from PocketBase (Settings -> Mail
# admin UI) to explicit env vars — see docs/SUPABASE_MIGRATION_PLAN.md
# Phase 4 and backend/supabase/PHASE4_NOTES.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=CLUSTR

# search-index / search-query. Same vars backend/docker-compose.yml's
# meilisearch service already uses — unchanged by this migration.
MEILI_URL=
MEILI_MASTER_KEY=

# PocketBase settings encryption key (optional, for production)
# Generate a 32-char hex key: openssl rand -hex 16
# Then uncomment and set:
# PB_ENCRYPTION_KEY=your-32-char-hex-key-here

# Memory limit for Go runtime (optional, for production)
# GOMEMLIMIT=512MiB

# Continuous backup (Litestream) — replicates the live database to
# S3-compatible object storage. Works with Cloudflare R2, Oracle Object
# Storage, AWS S3, or any S3-compatible endpoint. Leave unset to run without
# continuous backups (not recommended past Phase 0 — see docs/DEPLOYMENT.md).
# LITESTREAM_BUCKET=barangay-db-backup
# LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LITESTREAM_REGION=auto
# LITESTREAM_ACCESS_KEY_ID=your-access-key-id
# LITESTREAM_SECRET_ACCESS_KEY=your-secret-access-key

# Passkey sign-in (WebAuthn) — optional. Leave unset to run without it; the
# sidecar service just won't start. See docs/DEPLOYMENT.md "Step 8: Passkey
# sign-in (WebAuthn)". Use a DEDICATED superuser account for this, not your
# personal admin login.
# PB_SUPERUSER_EMAIL=webauthn-service@yourdomain.com
# PB_SUPERUSER_PASSWORD=your-long-random-password
# WEBAUTHN_RP_ID=records.yourdomain.com
# WEBAUTHN_RP_NAME=CLUSTR Barangay OS
# WEBAUTHN_ORIGINS=https://records.yourdomain.com

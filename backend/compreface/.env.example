# Self-hosted CompreFace's own bootstrap secrets. Copy to .env and fill in
# real values — never commit a real .env. Same category as
# backend/infisical/.env.example's three: these bootstrap CompreFace's own
# Postgres and admin-API signing, so they can't themselves be pulled from a
# secrets manager. Store in a password manager or your host's own secret
# store, not in a checked-in file.
#
#   openssl rand -base64 24   # for POSTGRES_PASSWORD
#   openssl rand -base64 32   # for ADMIN_SECRET

POSTGRES_USER=compreface
POSTGRES_PASSWORD=change-me
POSTGRES_DB=frs

ADMIN_SECRET=change-me

# Self-hosted Infisical's own bootstrap secrets. Copy to .env and fill in
# real values — never commit a real .env. Unlike backend/supabase/.env
# (Phase 5's whole point is to stop hand-editing that one), these three
# genuinely have nowhere else to live: they're what Infisical itself uses
# to encrypt/authenticate, so a secrets manager can't be used to bootstrap
# its own root of trust. Store these in a password manager or your host's
# own secret store (e.g. a cloud provider's KMS), not in a checked-in file.
#
#   openssl rand -hex 16      # for ENCRYPTION_KEY (must be exactly 32 hex chars)
#   openssl rand -base64 32   # for AUTH_SECRET
#   openssl rand -base64 24   # for POSTGRES_PASSWORD

ENCRYPTION_KEY=change-me-32-hex-chars-exactly12
AUTH_SECRET=change-me

POSTGRES_USER=infisical
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infisical

# Public URL this Infisical instance is reached at (see docker-compose.yml —
# published to 127.0.0.1:8060 by default; change if you put your own
# reverse proxy/VPN in front for remote admin access).
SITE_URL=http://localhost:8060

# Kong's gateway URL (backend/supabase/docker-compose.yml) — was PocketBase's
# own URL pre-migration, kept as the same env var since it plays the same
# "base URL of the backend" role.
VITE_API_URL=https://records.yourdomain.com
VITE_LOCAL_API_URL=http://192.168.YOUR_SERVER_LAN_IP:8000
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional — frontend error tracking (Sentry free tier: 5k events/month).
# Leave unset to run without it; nothing breaks either way.
VITE_SENTRY_DSN=

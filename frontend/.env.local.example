# Kong's gateway URL (backend/supabase/docker-compose.yml) — was PocketBase's
# own URL pre-migration, kept as the same env var since it plays the same
# "base URL of the backend" role.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=

# Cloudinary config lives server-side now (Security Phase 3 — signed
# uploads via the sign-cloudinary-upload Edge Function); see
# backend/supabase/functions/.env.example's CLOUDINARY_* vars instead.
